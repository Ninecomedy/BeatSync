{
  "name": "beatsync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "emulators": "node scripts/emulators.mjs start",
    "test": "node --test tests/game.test.js",
    "test:integration": "node scripts/emulators.mjs exec",
    "test:browser": "playwright test",
    "test:all": "node scripts/emulators.mjs exec \"node scripts/verify.mjs\"",
    "format": "prettier --write src scripts tests index.html *.json *.js README.md docs public/assets/README.md",
    "format:check": "prettier --check src scripts tests index.html *.json *.js README.md docs public/assets/README.md",
    "build:production": "node scripts/build-production.mjs"
  },
  "dependencies": {
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "firebase-tools": "^15.37.0",
    "prettier": "^3.10.1",
    "vite": "^7.2.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
